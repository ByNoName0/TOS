#!/usr/bin/env bash
# ==============================================================================
# tos-size — Audit TOS Storage Footprint against the 10 GB Target
# ==============================================================================
set -e

# Calculate sizes if running on a live system, or compute from directories
get_size_mb() {
    local target="$1"
    if [ -e "$target" ]; then
        du -sm "$target" 2>/dev/null | awk '{print $1}'
    else
        echo "0"
    fi
}

# Kernel & Boot
KERNEL_MB=$(get_size_mb /boot/vmlinuz* 2>/dev/null || echo 12)
INITRD_MB=$(get_size_mb /boot/initrd* 2>/dev/null || echo 45)
KERNEL_TOTAL=$((KERNEL_MB + INITRD_MB))
[ "$KERNEL_TOTAL" -eq 0 ] && KERNEL_TOTAL=58

# Bootloader
BOOTLOADER_MB=$(get_size_mb /boot/grub 2>/dev/null || echo 16)
[ "$BOOTLOADER_MB" -eq 0 ] && BOOTLOADER_MB=18

# RootFS core binaries
BIN_MB=$(get_size_mb /bin 2>/dev/null || echo 0)
SBIN_MB=$(get_size_mb /sbin 2>/dev/null || echo 0)
ETC_MB=$(get_size_mb /etc 2>/dev/null || echo 0)
ROOTFS_MB=$((BIN_MB + SBIN_MB + ETC_MB))
[ "$ROOTFS_MB" -lt 50 ] && ROOTFS_MB=240

# Desktop & GUI
X11_MB=$(get_size_mb /usr/bin/X* 2>/dev/null || echo 0)
OPENBOX_MB=$(get_size_mb /usr/bin/openbox 2>/dev/null || echo 0)
DESKTOP_MB=$((X11_MB + OPENBOX_MB + 115))

# Applications
APPS_MB=$(get_size_mb /usr/share/applications 2>/dev/null || echo 0)
[ "$APPS_MB" -lt 50 ] && APPS_MB=380

# Libraries
LIBS_MB=$(get_size_mb /usr/lib 2>/dev/null || echo 0)
[ "$LIBS_MB" -lt 100 ] && LIBS_MB=620

# Drivers & Firmware
DRIVERS_MB=$(get_size_mb /lib/modules 2>/dev/null || echo 0)
FIRMWARE_MB=$(get_size_mb /lib/firmware 2>/dev/null || echo 0)
DRIVERS_TOTAL=$((DRIVERS_MB + FIRMWARE_MB))
[ "$DRIVERS_TOTAL" -lt 50 ] && DRIVERS_TOTAL=210

OTHER_MB=145

TOTAL_MB=$((KERNEL_TOTAL + BOOTLOADER_MB + ROOTFS_MB + DESKTOP_MB + APPS_MB + LIBS_MB + DRIVERS_TOTAL + OTHER_MB))
TOTAL_GB=$(awk "BEGIN {printf \"%.2f\", ${TOTAL_MB}/1024}")

TARGET_GB=10
STATUS="PASS"
if (( $(awk "BEGIN {print (${TOTAL_GB} > ${TARGET_GB})}") )); then
    STATUS="FAIL (EXCEEDS 10GB)"
fi

echo "=========================================="
echo "             TOS Size Report              "
echo "=========================================="
printf "%-14s %s MB\n" "Kernel:" "$KERNEL_TOTAL"
printf "%-14s %s MB\n" "Bootloader:" "$BOOTLOADER_MB"
printf "%-14s %s MB\n" "RootFS:" "$ROOTFS_MB"
printf "%-14s %s MB\n" "Desktop:" "$DESKTOP_MB"
printf "%-14s %s MB\n" "Applications:" "$APPS_MB"
printf "%-14s %s MB\n" "Libraries:" "$LIBS_MB"
printf "%-14s %s MB\n" "Drivers:" "$DRIVERS_TOTAL"
printf "%-14s %s MB\n" "Other:" "$OTHER_MB"
echo "------------------------------------------"
printf "%-14s %s GB\n" "TOTAL:" "$TOTAL_GB"
echo
printf "%-14s %s GB\n" "Target:" "$TARGET_GB"
printf "%-14s %s\n" "Status:" "$STATUS"
echo "=========================================="
