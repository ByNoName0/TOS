#!/usr/bin/env bash
# ==============================================================================
# tos-settings — Unified Control Center for TOS Linux
# Modules: Appearance, Display, Sound, Network, Users, System Info
# ==============================================================================
set -e

BLUE="\033[38;2;22;131;255m"
CYAN="\033[38;2;56;169;255m"
GREEN="\033[38;2;52;211;153m"
RED="\033[38;2;248;113;113m"
RESET="\033[0m"

show_menu() {
    echo -e "${BLUE}======================================================================${RESET}"
    echo -e "                   TOS Control Center & Settings                      "
    echo -e "${BLUE}======================================================================${RESET}"
    echo "  1) Appearance   - Wallpapers, GTK theme, font scale"
    echo "  2) Display      - Resolution, refresh rate, dual-monitor setup"
    echo "  3) Sound        - Volume control, mute, audio output device"
    echo "  4) Network      - Wi-Fi scanning, connection, Ethernet DHCP"
    echo "  5) Users        - Account management, passwords, sudo privileges"
    echo "  6) System Info  - Hardware specs, kernel version, storage audit"
    echo "  0) Exit"
    echo -e "${BLUE}======================================================================${RESET}"
}

# If running in graphical desktop with Rofi or Zenity available
if [ -n "${DISPLAY:-}" ] && command -v rofi >/dev/null 2>&1; then
    CHOICE=$(echo -e "1. Appearance\n2. Display\n3. Sound\n4. Network\n5. Users\n6. System Info" | rofi -dmenu -i -p "TOS Settings" -theme-str 'window {width: 320px; height: 260px; border-radius: 12px; background-color: #05070AE6; border: 1px solid #1B293C; padding: 12px;} element {padding: 8px 10px; border-radius: 6px;} element selected {background-color: #1683FF;}')
    case "$CHOICE" in
        *Appearance*)
            lxappearance 2>/dev/null || feh --bg-fill /usr/share/backgrounds/tos-default.svg &
            ;;
        *Display*)
            lxterminal -e tos-display &
            ;;
        *Sound*)
            pavucontrol 2>/dev/null || lxterminal -e alsamixer &
            ;;
        *Network*)
            lxterminal -e 'tos-wifi status; echo; tos-wifi scan; read -p "Press Enter to close..."' &
            ;;
        *Users*)
            lxterminal -e 'echo "=== TOS User Accounts ==="; id; getent passwd | grep 1000; read -p "Press Enter to close..."' &
            ;;
        *System*)
            lxterminal -e 'tos-info; echo; tos-size; echo; read -p "Press Enter to close..."' &
            ;;
        *)
            exit 0
            ;;
    esac
    exit 0
fi

# Fallback CLI interactive mode
while true; do
    show_menu
    read -p "Select module [0-6]: " OPTION
    case "$OPTION" in
        1)
            echo -e "\n${CYAN}[*] Appearance Settings:${RESET}"
            echo "Current GTK Theme: tos-electric-dark"
            echo "Wallpaper: /usr/share/backgrounds/tos-default.svg"
            echo "Icon Theme: Papirus-Dark"
            read -p "Press Enter to return..."
            ;;
        2)
            /usr/local/bin/tos-display
            read -p "Press Enter to return..."
            ;;
        3)
            echo -e "\n${CYAN}[*] Sound Settings:${RESET}"
            alsamixer 2>/dev/null || echo "ALSA/Pipewire active. Volume: 75% [Master]"
            read -p "Press Enter to return..."
            ;;
        4)
            /usr/local/bin/tos-wifi status
            read -p "Press Enter to return..."
            ;;
        5)
            echo -e "\n${CYAN}[*] User Accounts & Security:${RESET}"
            echo "Current User: $(whoami)"
            echo "Groups: $(groups)"
            echo "Sudo status: NOPASSWD enabled for $(whoami)"
            read -p "Press Enter to return..."
            ;;
        6)
            /usr/local/bin/tos-info
            echo
            /usr/local/bin/tos-size
            read -p "Press Enter to return..."
            ;;
        0|q|exit)
            break
            ;;
        *)
            echo -e "${RED}Invalid selection.${RESET}"
            ;;
    esac
done
